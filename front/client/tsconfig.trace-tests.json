{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "..",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "isolatedModules": false,
    "verbatimModuleSyntax": false,
    "types": ["node"]
  },
  "include": [
    "src/pages/chat/streaming-session.ts",
    "src/pages/chat/message-utils.ts",
    "src/pages/chat/streaming-session.trace.test.ts",
    "src/types/**/*.ts",
    "../shared/types/**/*.ts"
  ]
}
