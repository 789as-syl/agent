# Application
APP_NAME=Knowledge Base Agent
APP_ENV=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_base
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_base_test
DATABASE_REQUIRE_HEAD_REVISION=true

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
# ⚠️ 生产环境必须修改默认凭证！
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=documents
MINIO_MAX_CONNECTIONS=10

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
ALLOW_UNSAFE_TEST_DB=false

# CORS
# ⚠️ 生产环境必须设置具体域名，不要使用 *
# 例如: https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# JWT / Auth
# ⚠️ 生产环境必须提供至少 32 字符高熵密钥
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
JWT_REFRESH_EXPIRATION_DAYS=7

# 密码哈希
# bcrypt 工作因子（10-16，值越大越安全但越慢）
BCRYPT_WORK_FACTOR=12

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# DashScope / Retrieval
RETRIEVAL_EMBEDDING_MODEL=text-embedding-v3
RETRIEVAL_EMBEDDING_DIMENSION=1024
RETRIEVAL_EMBEDDING_BATCH_SIZE=10
DASHSCOPE_EMBEDDING_MAX_BATCH_SIZE=10
RETRIEVAL_RERANK_MODEL=qwen3-rerank
RETRIEVAL_RERANK_TOP_N=10

# Agent generation
AGENT_GENERATION_MODEL=qwen-turbo
AGENT_GENERATION_TEMPERATURE=0.3
AGENT_GENERATION_MAX_TOKENS=1200
AGENT_ENABLE_THINKING=true
AGENT_ENABLED_TOOLS=knowledge_retrieval,math_calculator
AGENT_THINKING_BUDGET=
AGENT_STREAM_DIAGNOSTICS=false
AGENT_CHECKPOINT_DATABASE_URL=

# Agent memory / summarization
AGENT_MEMORY_SHORT_WINDOW=12
AGENT_MEMORY_SUMMARY_TRIGGER_MESSAGES=8
AGENT_MEMORY_SUMMARY_MAX_CHARS=1200
MEMORY_SUMMARY_MODEL=qwen-turbo
MEMORY_SUMMARY_TEMPERATURE=0.2
MEMORY_SUMMARY_MAX_TOKENS=800

# Ingestion / parsing
MAX_UPLOAD_SIZE=52428800
ALLOWED_FILE_TYPES=md,html,txt,pdf,docx,pptx
INGESTION_CHUNK_SIZE_TEXT=600
INGESTION_CHUNK_OVERLAP_TEXT=60
INGESTION_CHUNK_SIZE_MARKDOWN=800
INGESTION_CHUNK_OVERLAP_MARKDOWN=80
INGESTION_CACHE_DIR=.omx/cache/docling

# Observability / admin
ADMIN_ANALYTICS_CACHE_TTL=60
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=knowledge-base-agent
LANGSMITH_ENDPOINT=
